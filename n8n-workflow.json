    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const services = [\n  { service: \"Socket installation\", base: 50, unit: \"unit\", per: 10, urgency: 1.5 },\n  { service: \"Light installation\", base: 40, unit: \"unit\", per: 8, urgency: 1.3 },\n  { service: \"Wiring\", base: 80, unit: \"meter\", per: 5, urgency: 1.2 },\n  { service: \"Inspection\", base: 40, unit: \"fixed\", per: 0, urgency: 1.0 },\n  { service: \"Emergency repair\", base: 100, unit: \"fixed\", per: 0, urgency: 2.0 }\n];\n\nconst s = services.find(x => x.service === $json.service);\n\nif (!s) {\n  return {\n    json: {\n      reply: \"Service not found.\"\n    }\n  };\n}\n\nlet price = s.base;\n\nif (s.unit !== \"fixed\") {\n  price += $json.quantity * s.per;\n}\n\nif ($json.urgency === \"urgent\") {\n  price *= s.urgency;\n}\n\nprice = Math.round(price);\n\nreturn {\n  json: {\n    service: s.service,\n    quantity: $json.quantity,\n    urgency: $json.urgency,\n    price,\n    reply: `Estimated price for ${s.service}: €${price}. Would you like to book an appointment?`\n  }\n};"
      },
