    {
      "parameters": {
        "jsCode": "const selectedSlot =\n  $('Webhook').first().json.body.slot;\n\n// German timezone\nconst TZ_OFFSET = \"+02:00\";\n\n// Convert slot into German timezone\nconst slotWithTZ = selectedSlot + TZ_OFFSET;\n\nconst slotStart = new Date(slotWithTZ);\n\nconst slotEnd =\n  new Date(slotStart.getTime() + 3600000);\n\nconst items = $input.all();\n\nconst busy = items\n  .filter(item => item.json.start && item.json.end)\n  .map(item => ({\n    start: new Date(\n      item.json.start.dateTime ||\n      item.json.start.date\n    ),\n\n    end: new Date(\n      item.json.end.dateTime ||\n      item.json.end.date\n    ),\n  }));\n\nconst overlapping = busy.some(event =>\n\n  slotStart.getTime() < event.end.getTime() &&\n  slotEnd.getTime()   > event.start.getTime()\n\n);\n\nreturn {\n  json: {\n    slotAvailable: !overlapping,\n    selectedSlot,\n  }\n};"
      },
