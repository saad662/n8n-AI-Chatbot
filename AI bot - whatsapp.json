    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst pricingData = $('Pricing').first().json;\n\n// Parse busy events from Google Calendar\nconst busy = items\n  .filter(item => item.json.start && item.json.end)\n  .map(item => ({\n    start: new Date(item.json.start.dateTime || item.json.start.date),\n    end:   new Date(item.json.end.dateTime   || item.json.end.date),\n  }));\n\n// German timezone\nconst TZ_OFFSET = \"+02:00\";\n\nconst possibleSlots = [];\nconst now = new Date();\n\n// Generate slots for next 7 days\nfor (let dayOffset = 0; dayOffset < 7; dayOffset++) {\n\n  const day = new Date(now);\n  day.setUTCDate(day.getUTCDate() + dayOffset);\n\n  for (let hour = 9; hour < 17; hour++) {\n\n    const pad = n => String(n).padStart(2, '0');\n\n    const y = day.getUTCFullYear();\n    const m = pad(day.getUTCMonth() + 1);\n    const d = pad(day.getUTCDate());\n\n    // German local time\n    const localISO =\n      `${y}-${m}-${d}T${pad(hour)}:00:00${TZ_OFFSET}`;\n\n    const slotStart = new Date(localISO);\n\n    if (slotStart <= now) continue;\n\n    const slotEnd =\n      new Date(slotStart.getTime() + 3600000);\n\n    const isBusy = busy.some(event =>\n      slotStart.getTime() < event.end.getTime() &&\n      slotEnd.getTime()   > event.start.getTime()\n    );\n\n    if (!isBusy) {\n\n      // Send clean format to frontend\n      possibleSlots.push(\n        `${y}-${m}-${d}T${pad(hour)}:00:00`\n      );\n\n    }\n  }\n}\n\nreturn {\n  json: {\n    reply: pricingData.reply,\n\n    service: pricingData.service,\n    quantity: pricingData.quantity,\n    urgency: pricingData.urgency,\n    price: pricingData.price,\n\n    customerName:\n      $('Webhook').first().json.body.customerName,\n\n    phone:\n      $('Webhook').first().json.body.phone,\n\n    email:\n      $('Webhook').first().json.body.email,\n\n    slots: possibleSlots\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
