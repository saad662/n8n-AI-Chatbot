              "content": "=Extract structured info from this message.\n\nReturn ONLY JSON:\n\n{\n  \"service\": \"\",\n  \"quantity\": number,\n  \"urgency\": \"normal\" or \"urgent\"\n}\n\nMessage:\n{{$json[\"body\"][\"message\"]}}"
